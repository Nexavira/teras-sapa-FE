{
  "name": "Home Page",
  "layout": "theme",
  "sections": {
    "header_main": {
      "type": "header",
      "settings": {
        "logo_position": "middle-left",
        "sticky_header_type": "on-scroll-up",
        "show_line_separator": true,
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 20,
        "logo_text": "Teras Sapa"
      },
      "block_order": ["announcement_1"],
      "blocks": {
        "announcement_1": {
          "type": "announcement",
          "settings": {
            "text": "✨ Summer Sale: Up to 50% off select apparel & accessories!",
            "link": "/collections/summer-sale",
            "text_alignment": "center",
            "color_scheme": "scheme-2"
          }
        }
      }
    },
    "hero_banner_1": {
      "type": "hero_banner",
      "settings": {
        "text_alignment": "center",
        "banner_height": "medium",
        "color_scheme": "scheme-3",
        "overlay_opacity": 40
      },
      "block_order": ["heading_1", "text_1", "button_1"],
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "heading": "Elevate Your Everyday Style",
            "heading_size": "large",
            "heading_tag": "h1"
          }
        },
        "text_1": {
          "type": "text",
          "settings": {
            "text": "Discover the latest seasonal collection crafted with sustainable materials and timeless silhouettes.",
            "text_style": "subheading"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "button_label": "Shop Collection",
            "button_link": "/collections/all",
            "button_style": "primary"
          }
        }
      }
    },
    "featured_collection_1": {
      "type": "featured_collection",
      "settings": {
        "title": "Featured Collection",
        "description": "Explore our handpicked curation of bestsellers and essential pieces.",
        "products_to_show": 4,
        "columns_desktop": "4",
        "show_view_all": true,
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": ["header_main", "hero_banner_1", "featured_collection_1"]
}

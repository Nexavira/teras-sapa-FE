[
  {
    "name": "theme_info",
    "theme_name": "Forge Manufacturing",
    "theme_version": "1.1.0",
    "theme_author": "Teras Sapa",
    "theme_documentation_url": "https://github.com/teras-sapa/themes",
    "theme_support_url": "https://support.teras-sapa.com"
  },
  {
    "name": "Brand & Identity",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Desktop logo" },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Desktop logo width",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "logo_mobile",
        "label": "Mobile logo (optional)"
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "label": "Mobile logo width",
        "min": 60,
        "max": 220,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      { "type": "image_picker", "id": "favicon", "label": "Favicon image" },
      {
        "type": "text",
        "id": "company_name",
        "label": "Company name",
        "default": "ATLAS / INDUSTRIES"
      },
      {
        "type": "text",
        "id": "company_tagline",
        "label": "Company tagline",
        "default": "Precision at industrial scale"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "name": "Color schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#E9E7E1"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Optional background gradient overlay"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#171915"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Solid button background",
            "default": "#171915"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Solid button label",
            "default": "#F4F1E9"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Outline button",
            "default": "#171915"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "Shadow",
            "default": "#171915"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": { "background": "button", "text": "button_label" },
          "secondary_button": {
            "background": "background",
            "text": "secondary_button_label"
          }
        }
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Brand accent",
        "default": "#F15A24"
      },
      {
        "type": "color",
        "id": "surface_color",
        "label": "Raised surface",
        "default": "#F4F1E9"
      },
      {
        "type": "color",
        "id": "muted_color",
        "label": "Muted text and details",
        "default": "#6B6E66"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#247A4A"
      },
      {
        "type": "color",
        "id": "color_warning",
        "label": "Warning",
        "default": "#B76B1D"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Error",
        "default": "#B6382F"
      },
      {
        "type": "color",
        "id": "color_info",
        "label": "Information",
        "default": "#356899"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "font_heading",
        "label": "Heading font",
        "default": "Geist, 'Avenir Next', sans-serif",
        "options": [
          { "label": "Geist", "value": "Geist, 'Avenir Next', sans-serif" },
          {
            "label": "Plus Jakarta Sans",
            "value": "'Plus Jakarta Sans', 'Avenir Next', sans-serif"
          },
          {
            "label": "Clash Display",
            "value": "'Clash Display', 'Avenir Next', sans-serif"
          },
          { "label": "Outfit", "value": "Outfit, 'Avenir Next', sans-serif" }
        ]
      },
      {
        "type": "select",
        "id": "font_heading_weight",
        "label": "Heading weight",
        "default": "500",
        "options": [
          { "label": "Regular (400)", "value": "400" },
          { "label": "Medium (500)", "value": "500" },
          { "label": "Semi bold (600)", "value": "600" },
          { "label": "Bold (700)", "value": "700" }
        ]
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading scale",
        "min": 80,
        "max": 125,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "Heading letter spacing",
        "min": -3,
        "max": 2,
        "step": 0.25,
        "unit": "px",
        "default": -1
      },
      {
        "type": "select",
        "id": "heading_text_transform",
        "label": "Heading text transform",
        "default": "none",
        "options": [
          { "label": "None", "value": "none" },
          { "label": "Uppercase", "value": "uppercase" },
          { "label": "Capitalize", "value": "capitalize" }
        ]
      },
      {
        "type": "select",
        "id": "font_body",
        "label": "Body font",
        "default": "'Plus Jakarta Sans', 'Avenir Next', sans-serif",
        "options": [
          {
            "label": "Plus Jakarta Sans",
            "value": "'Plus Jakarta Sans', 'Avenir Next', sans-serif"
          },
          { "label": "Geist", "value": "Geist, 'Avenir Next', sans-serif" },
          { "label": "Outfit", "value": "Outfit, 'Avenir Next', sans-serif" }
        ]
      },
      {
        "type": "select",
        "id": "font_body_weight",
        "label": "Body weight",
        "default": "400",
        "options": [
          { "label": "Regular (400)", "value": "400" },
          { "label": "Medium (500)", "value": "500" },
          { "label": "Semi bold (600)", "value": "600" }
        ]
      },
      {
        "type": "range",
        "id": "font_body_base_size",
        "label": "Body base size",
        "min": 13,
        "max": 19,
        "step": 1,
        "unit": "px",
        "default": 15
      },
      {
        "type": "range",
        "id": "font_body_line_height",
        "label": "Body line height",
        "min": 1.3,
        "max": 2,
        "step": 0.05,
        "default": 1.65
      }
    ]
  },
  {
    "name": "Layout & Grid",
    "settings": [

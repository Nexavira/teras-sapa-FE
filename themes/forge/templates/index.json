{
  "name": "Home",
  "layout": "theme",
  "sections": {
    "header_main": {
      "type": "header",
      "settings": {
        "logo_text": "ATLAS / INDUSTRIES",
        "cta_label": "Start a project",
        "cta_url": "/preview?theme=forge&template=contact"
      }
    },
    "hero": {
      "type": "company_hero",
      "settings": {
        "layout_style": "frame",
        "text_alignment": "left",
        "banner_height": "auto",
        "color_scheme": "scheme-1",
        "padding_top": 160,
        "padding_bottom": 34
      },
      "block_order": ["heading_1", "text_1", "button_1", "image_1"],
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "heading": "Engineered with intent. Built without compromise.",
            "heading_size": "display",
            "heading_tag": "h1",
            "text_align": "left"
          }
        },
        "text_1": {
          "type": "text",
          "settings": {
            "text": "Precision manufacturing for the systems that keep the world moving.",
            "text_style": "intro",
            "text_align": "left",
            "max_width": 620
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "button_label": "Explore capabilities",
            "button_link": "/preview?theme=forge&template=capabilities",
            "button_style": "primary",
            "button_size": "medium"
          }
        },
        "image_1": {
          "type": "image",
          "settings": {
            "image": "https://images.unsplash.com/photo-1565793298595-6a879b1d9492?auto=format&fit=crop&w=1800&q=88",
            "media_height": "large",
            "overlay_opacity": 40,
            "show_stamp": true,
            "stamp_text": "Made to\nendure\n↘",
            "stamp_position": "bottom-right",
            "stamp_color": "orange"
          }
        }
      }
    },
    "metrics": {
      "type": "company_metrics",
      "settings": {
        "color_scheme": "scheme-1",
        "dark_mode": false
      },
      "blocks": {
        "metrics_heading": {
          "type": "heading",
          "settings": {
            "heading": "Industrial capability, human accountability.",
            "heading_size": "large",
            "heading_tag": "h2"
          }
        },
        "grid_metrics": {
          "type": "grid",
          "settings": {
            "columns": 3,
            "gap": 16
          },
          "block_order": ["metric_1", "metric_2", "metric_3"],
          "blocks": {
            "metric_1": {
              "type": "metric_item",
              "settings": {
                "stat": "38",
                "label": "years of engineering craft",
                "accent": true,
                "width": "1"
              }
            },
            "metric_2": {
              "type": "metric_item",
              "settings": {
                "stat": "0.01",
                "label": "mm verified tolerance",
                "accent": false,
                "width": "1"
              }
            },
            "metric_3": {
              "type": "metric_item",
              "settings": {
                "stat": "17",
                "label": "markets delivered",
                "accent": false,
                "width": "1"
              }
            }
          }
        }
      },
      "block_order": ["metrics_heading", "grid_metrics"]
    },
    "capabilities": {
      "type": "company_bento",
      "settings": {
        "color_scheme": "scheme-2",
        "dark_mode": true
      },
      "blocks": {
        "bento_heading": {
          "type": "heading",
          "settings": {
            "heading": "One partner, from first drawing to factory floor.",
            "heading_size": "large",
            "heading_tag": "h2"
          }
        },
        "bento_grid": {
          "type": "grid",
          "settings": {
            "columns": 12,
            "gap": 20
          },
          "blocks": {
            "bento_1": {
              "type": "bento_card",
              "settings": {
                "tag": "Capability",
                "title": "Precision fabrication",
                "description": "Five-axis machining, robotic welding and complex metalwork held to microscopic tolerances.",
                "span": "7",
                "dark": true
              }
            },
            "bento_2": {
              "type": "bento_card",
              "settings": {
                "tag": "Capability",
                "title": "Systems integration",
                "description": "Mechanical, electrical and control systems assembled, tested and commissioned as one.",
                "span": "5",
                "dark": true
              }
            },
            "bento_3": {
              "type": "bento_card",
              "settings": {
                "tag": "Capability",
                "title": "Industrial automation",
                "description": "Purpose-built production cells that improve repeatability, throughput and operator safety.",
                "span": "12",
                "dark": true
              }
            }
          },
          "block_order": ["bento_1", "bento_2", "bento_3"]
        },
        "bento_cta": {
          "type": "button",
          "settings": {
            "button_label": "Explore capabilities",
            "button_link": "/preview?theme=forge&template=capabilities",
            "button_style": "primary",
            "button_size": "medium"
          }
        }
      },
      "block_order": ["bento_heading", "bento_grid", "bento_cta"]
    },
    "quote": {
      "type": "company_quote",
      "settings": {
        "color_scheme": "scheme-1",
        "quote": "We make the critical parts behind everyday momentum.",
        "highlight": "everyday momentum."
      }
    },
    "footer_main": {
      "type": "footer",
      "settings": {
        "heading": "Built for what comes next.",
        "email": "projects@atlas-industries.com",
        "location": "West Java · Indonesia"
      }
    }
  },
  "order": [
    "header_main",
    "hero",
    "metrics",
    "capabilities",
    "quote",
    "footer_main"
  ]
}

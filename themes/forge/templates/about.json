      "block_order": ["heading_1", "text_1", "image_1"],
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "heading": "We built our reputation one tolerance at a time.",
            "heading_size": "display",
            "heading_tag": "h1"
          }
        },
        "text_1": {
          "type": "text",
          "settings": {
            "text": "Independent manufacturing expertise, shaped by four decades of solving consequential engineering problems.",
            "text_style": "intro",
            "max_width": 620
          }
        },
        "image_1": {
          "type": "image",
          "settings": {
            "image": "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1800&q=88",
            "media_height": "large",
            "overlay_opacity": 40,
            "show_stamp": true,
            "stamp_text": "Made to\nendure\n↘"
          }
        }
      }
    },
    "principle": {

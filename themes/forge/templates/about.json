        "principle_manifesto": {
          "type": "manifesto_card",
          "settings": {
            "quote": "Atlas began as a twelve-person machine shop in 1987. Today, more than 620 specialists work across design, fabrication, automation and quality. The scale changed. The standard never did.",
            "show_glyph": true
          }
        }
      }
    },

    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^30.0.1",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

{
  "name": "teras-sapa",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#themes/*": "./themes/*",
    "#themes": "./themes/index.ts"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "generate-routes": "tsr generate",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/react": "^0.5.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/tanstackstart-react": "^10.71.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "latest",
    "@tanstack/router-plugin": "^1.168.35",
    "@tanstack/store": "latest",
    "better-auth": "^1.7.1",
    "dotenv-cli": "^11.0.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "hugeicons-react": "^0.4.0",
    "lenis": "^1.3.26",
    "nitro": "npm:nitro-nightly@latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "streamdown": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@netlify/vite-plugin-tanstack-start": "^1.3.18",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/tanstack-react": "^10.6.0",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/eslint-plugin-query": "^5.102.5",
    "@tanstack/router-cli": "^1.167.33",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
